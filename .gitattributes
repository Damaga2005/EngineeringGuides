# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Force binary treatment for PDFs and media (strictly prevent any CRLF translation)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Explicit text files with LF line endings
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.txt text eol=lf
