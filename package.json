{
  "name": "engineering-guides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "python -m scripts.foundation.pipeline && python -m scripts.project_first.pipeline",
    "dev": "node scripts/generate_catalog.js && vite",
    "build": "python -m scripts.foundation.pipeline && python -m scripts.project_first.pipeline && vite build && node scripts/copy_guides.js",
    "preview": "vite preview",
    "pipeline": "python -m scripts.foundation.pipeline && python -m scripts.project_first.pipeline",
    "validate": "python -m scripts.foundation.validators && python -m scripts.project_first.validators",
    "test": "pytest tests -v"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
